{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bald",
  "version": "0.1.4",
  "identifier": "app.bald.desktop",
  "build": { "frontendDist": "web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "Bald", "visible": false,
      "width": 488, "height": 720, "resizable": false,
      "maximizable": false, "center": true, "decorations": false,
      "transparent": true, "shadow": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/mightyidler/Bald/main/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFRjEzNEE1QUMyOTJGNUQKUldSZEx5bXNwVFR4Zm1VRStKdW1jS1FoWjdUTUtJNVFCQjJ5M0x1akgvbFB4cFJ0RUtHdTM2SEEK",
      "windows": { "installMode": "passive" }
    }
  }
}
